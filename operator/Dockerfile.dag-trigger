FROM golang:1.22-alpine AS builder

WORKDIR /workspace

# Cache dependencies before copying source
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build the dag-trigger binary
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o bin/dag-trigger ./cmd/dag-trigger/

# ---------------------------------------------------------------------------
# Final minimal image
# ---------------------------------------------------------------------------
FROM gcr.io/distroless/static:nonroot

WORKDIR /
COPY --from=builder /workspace/bin/dag-trigger .

USER 65532:65532

ENTRYPOINT ["/dag-trigger"]
